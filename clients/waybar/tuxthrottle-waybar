#!/usr/bin/env python3
"""waybar / eww custom module for TuxThrottle.

Emits one line of waybar JSON from `tuxthrottlectl status --json`:

    {"text": " 61°C  P", "tooltip": "...", "class": "warm", "percentage": 61}

`class` is one of cool / warm / hot / critical (style it in your waybar CSS).
With `--toggle` it cycles the platform profile (balanced -> performance ->
balanced) via tuxthrottlectl and exits — wire that to `on-click`.

waybar config:

    "custom/tuxthrottle": {
        "exec": "/opt/tuxthrottle/clients/waybar/tuxthrottle-waybar",
        "return-type": "json",
        "interval": 5,
        "on-click": "/opt/tuxthrottle/clients/waybar/tuxthrottle-waybar --toggle"
    }
"""
import json
import os
import shutil
import subprocess
import sys

CTL = shutil.which("tuxthrottlectl") or "/opt/tuxthrottle/tuxthrottlectl.py"


def _ctl(*args: str) -> subprocess.CompletedProcess:
    cmd = [sys.executable, CTL, *args] if CTL.endswith(".py") else [CTL, *args]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=15)


def _ctl_root(*args: str) -> subprocess.CompletedProcess:
    """A privileged tuxthrottlectl call (set / profile apply). Tries directly
    first (works when tuxthrottled's socket is up), then via `pkexec` — the
    PolkitTuxthrottlectl tweak makes that passwordless for an active local
    user; without it pkexec shows a normal auth dialog."""
    r = _ctl(*args)
    if r.returncode == 0 or os.geteuid() == 0:
        return r
    exe = shutil.which("pkexec")
    ctl = shutil.which("tuxthrottlectl") or "/usr/local/bin/tuxthrottlectl"
    if not exe:
        return r
    try:
        return subprocess.run([exe, ctl, *args], capture_output=True,
                              text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        r.stderr = (r.stderr or "") + f"\npkexec: {exc}"
        return r


def _emit(obj: dict) -> None:
    print(json.dumps(obj), flush=True)


def toggle() -> int:
    st = _status()
    cur = (st.get("platform_profile") or "balanced").lower()
    nxt = "performance" if cur != "performance" else "balanced"
    r = _ctl_root("set", "power-profile", nxt)
    _emit({"text": f" {nxt}", "tooltip": r.stdout.strip() or r.stderr.strip()})
    return r.returncode


def _status() -> dict:
    try:
        r = _ctl("status", "--json")
        return json.loads(r.stdout) if r.returncode == 0 else {}
    except (subprocess.SubprocessError, ValueError):
        return {}


def main() -> int:
    if "--toggle" in sys.argv[1:]:
        return toggle()

    st = _status()
    if not st:
        _emit({"text": "  n/a", "tooltip": "tuxthrottlectl not reachable",
               "class": "critical"})
        return 0

    cpu = (st.get("cpu") or {}).get("temp_c")
    dgpu = (st.get("dgpu") or {}).get("temp_c")
    prof = (st.get("platform_profile") or "?")[:1].upper()
    hot = max([t for t in (cpu, dgpu) if isinstance(t, (int, float))], default=0)
    cls = ("critical" if hot >= 95 else "hot" if hot >= 85
           else "warm" if hot >= 70 else "cool")

    parts = []
    if isinstance(cpu, (int, float)):
        parts.append(f" {cpu:.0f}°")
    if isinstance(dgpu, (int, float)):
        parts.append(f"󰢮 {dgpu:.0f}°")
    parts.append(prof)

    tip = [f"profile: {st.get('platform_profile')}"]
    tdp = st.get("tdp") or {}
    if tdp.get("stapm_limit"):
        tip.append(f"TDP: {tdp['stapm_limit']:.0f}/{tdp.get('fast_limit',0):.0f}/"
                   f"{tdp.get('slow_limit',0):.0f} W")
    gm = st.get("gamemode") or {}
    if gm.get("active"):
        tip.append("Feral GameMode: active")
    fans = st.get("fans") or []
    if fans:
        tip.append("fans: " + ", ".join(f"{f['label']} {f['rpm']}rpm" for f in fans))

    _emit({"text": "  " + "  ".join(parts), "class": cls,
           "percentage": int(hot), "tooltip": "\n".join(tip)})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
